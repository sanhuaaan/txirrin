# Copiar a ~/.dbizi.env en la VM (chmod 600). Lo leen todos los scripts del cron.
POSTGRES_PASSWORD=cambia-esto            # la misma que en /opt/dbizi/.env
# Buckets propios (los nombres de GCS son globales: los de abajo son los del proyecto
# original y no los podrás usar). viz = público (la web); backup = privado (dumps y crudo).
TXIRRIN_BUCKET_VIZ=gs://tu-bucket-viz
TXIRRIN_BUCKET_BACKUP=gs://tu-bucket-backup
# Opcional: URLs de ping de healthchecks.io; sin ellas los scripts funcionan igual.
HC_COLLECT=
HC_BACKUP=
