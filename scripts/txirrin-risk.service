[Unit]
Description=Txirrin: prediccion de riesgo de vaciado para el timelapse

[Service]
Type=oneshot
# %h = home del usuario; ajusta la ruta si el repo no está en ~/workspace/txirrin
WorkingDirectory=%h/workspace/txirrin
ExecStart=%h/workspace/txirrin/.venv/bin/python scripts/risk_forecast.py
Nice=10
